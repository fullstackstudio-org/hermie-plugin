# The web client under dashboard/app/ is generated by the app repository's build
# and imported with scripts/import_web_client.py. It is reviewed against its
# build.json and the CI rebuild, not line by line.
#
# -text: never convert line endings. The plugin hashes these files at load and CI
# compares them byte for byte with a rebuild, so a checkout must hold exactly the
# committed bytes on every platform.
dashboard/app/** -text linguist-generated=true

# The hashed assets are minified: a diff of one is noise, and a merge of two is
# never right. Re-import instead.
dashboard/app/assets/** -diff -merge
